# Runs without ProPresenter. Switch to http only after checking installed API docs.
PROPRESENTER_ADAPTER=mock
PROPRESENTER_HOST=127.0.0.1
# No guessed API port. Copy the actual value from ProPresenter Network settings.
PROPRESENTER_PORT=
PROPRESENTER_PROTOCOL=http
PROPRESENTER_PROFILE=profiles/propresenter.local.json
POLL_INTERVAL_MS=750
REQUEST_TIMEOUT_MS=2500
# Optional bearer token, if your installation requires one. Never logged.
PROPRESENTER_TOKEN=
# Optional fixed log destination; otherwise a new logs/session-*.jsonl is created.
LOG_FILE=

# Offline follower/transcription (no API key; audio stays local).
WHISPER_BIN=.local/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=.local/whisper.cpp/models/ggml-tiny.en.bin
WHISPER_LANGUAGE=en
FFMPEG_BIN=ffmpeg

# Fixed-plan acoustic following: npm run setup:ctc (music-trained CPU model).
# Optional custom paths; --acoustic-model music|small selects an explicit profile.
# CTC_PYTHON=.local/guided-ctc/venv/bin/python
# CTC_MODEL=.local/guided-ctc/music/model.safetensors
# CTC_VOCAB=.local/guided-ctc/music/vocab.json
